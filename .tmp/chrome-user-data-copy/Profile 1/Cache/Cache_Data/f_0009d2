<!DOCTYPE html><html><head><meta charset="UTF-8"><style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Inter:wght@400;500;600&display=swap');
    *{margin:0;padding:0;box-sizing:border-box}
    body{width:1080px;height:1080px;font-family:'Inter',sans-serif;overflow:hidden;position:relative;color:#fff}
    .bg{position:absolute;top:0;left:0;right:0;bottom:0;background:url('data:image/png;base64,') center center/cover}
    .overlay{position:absolute;top:0;left:0;right:0;bottom:0;background:linear-gradient(180deg,rgba(10,8,15,0.88) 0%,rgba(10,8,15,0.35) 55%,rgba(10,8,15,0.55) 100%)}
    .content{position:relative;z-index:10;padding:60px 75px;height:100%;display:flex;flex-direction:column;justify-content:center}
    .logo{position:absolute;top:50px;left:75px;font-size:24px;font-weight:700;color:rgba(255,255,255,0.6)}.logo span{color:#9F1239}
    .big{font-family:'Playfair Display',serif;font-weight:700;color:#f0c8d0;line-height:0.85;margin-bottom:16px}
    h1{font-family:'Playfair Display',serif;font-size:50px;font-weight:400;line-height:1.25;max-width:700px}
    h1 em,.hl em{font-style:italic;color:#f0c8d0}
    .hl{font-family:'Playfair Display',serif;font-size:66px;font-weight:400;line-height:1.15;max-width:800px;margin-bottom:24px}
    .small{font-size:13px;color:rgba(255,255,255,0.55);margin-top:16px}
    .quote{font-family:'Playfair Display',serif;font-size:44px;font-weight:400;font-style:italic;line-height:1.35;max-width:820px;margin-bottom:30px}
    .divider{width:60px;height:2px;background:rgba(255,255,255,0.2);margin-bottom:18px}
    .fix{font-size:16px;line-height:1.6;color:rgba(255,255,255,0.55);max-width:600px}
    .fix strong{color:#fff;font-weight:500}
    .btn{display:inline-block;margin-top:28px;background:#9F1239;color:#fff;padding:14px 36px;border-radius:28px;font-size:15px;font-weight:600;box-shadow:0 6px 25px rgba(159,18,57,0.3)}
    .cta{position:absolute;bottom:40px;right:75px;font-size:13px;font-weight:500;z-index:10;color:#fff;opacity:0.5}
  </style></head><body>
    <div class="bg"></div><div class="overlay"></div>
    <div class="content"><div class="logo">s<span>.</span></div><h1 class="hl">A fila não precisa ser <em>um caos.</em></h1>
      <p class="fix">Lista de espera inteligente via WhatsApp. Clientes avisados em tempo real.</p></div>
    <div class="cta">seatable.one</div>
  </body></html>