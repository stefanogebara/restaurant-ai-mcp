<!DOCTYPE html><html><head><meta charset="UTF-8"><style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Inter:wght@400;500;600&display=swap');
    *{margin:0;padding:0;box-sizing:border-box}
    body{width:1080px;height:1080px;font-family:'Inter',sans-serif;overflow:hidden;position:relative;color:#fff}
    .bg{position:absolute;top:0;left:0;right:0;bottom:0;background:url('data:image/png;base64,') center center/cover}
    .bg::before{content:'';position:absolute;top:0;left:0;right:0;height:550px;background:linear-gradient(rgba(13,17,23,0.9),rgba(13,17,23,0.3))}
    .bg::after{content:'';position:absolute;bottom:0;left:0;right:0;height:200px;background:linear-gradient(transparent,rgba(13,17,23,0.6))}
    .text{position:relative;z-index:10;padding:65px 80px}
    .logo{font-size:22px;font-weight:700;color:rgba(255,255,255,0.5);margin-bottom:50px}.logo span{color:#9F1239}
    h1{font-family:'Playfair Display',serif;font-size:68px;font-weight:400;line-height:1.15;margin-bottom:50px}
    h1 em{font-style:italic;color:#9F1239}
    .stats{display:flex;gap:40px}
    .si .val{font-family:'Playfair Display',serif;font-size:42px;font-weight:700;margin-bottom:6px}
    .si:first-child .val{color:#9F1239}
    .si:last-child .val{color:#2e8b57}
    .si .lbl{font-size:13px;color:rgba(255,255,255,0.5);line-height:1.4;max-width:150px}
    .btn{display:inline-block;margin-top:40px;background:#9F1239;color:#fff;padding:14px 36px;border-radius:28px;font-size:15px;font-weight:600;box-shadow:0 6px 25px rgba(159,18,57,0.3)}
    .dot{position:absolute;bottom:45px;left:80px;width:12px;height:12px;background:#9F1239;border-radius:50%;z-index:10}
    .cta{position:absolute;bottom:40px;right:80px;font-size:14px;font-weight:600;color:#0D1117;background:#fff;padding:10px 22px;border-radius:24px;z-index:10}
  </style></head><body>
    <div class="bg"></div>
    <div class="text">
      <div class="logo">s<span>.</span></div>
      <h1>A IA que seu restaurante <em>precisa.</em></h1>
      <div class="stats">
        <div class="si"><div class="val">24/7</div><div class="lbl">IA via WhatsApp</div></div>
        <div class="si"><div class="val">30s</div><div class="lbl">Confirmação</div></div>
        <div class="si"><div class="val">R$149</div><div class="lbl">Por mês</div></div>
        <div class="si"><div class="val">14 dias</div><div class="lbl">Teste grátis</div></div>
      </div>
      <div class="btn">Teste grátis por 14 dias &rarr;</div>
    </div>
    <div class="dot"></div>
    <div class="cta">seatable.one &rarr;</div>
  </body></html>