# ========================================
# Restaurant AI MCP - Environment Variables
# ========================================

# Deployment Configuration
NODE_ENV=production
PORT=3001
CLIENT_URL=https://restaurant-ai-mcp.vercel.app

# ========================================
# Supabase PostgreSQL Database (REQUIRED)
# ========================================
# Get these from: https://app.supabase.com/project/[your-project-id]/settings/api

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here  # Optional: For admin operations

# ========================================
# AI Services (REQUIRED)
# ========================================

# Anthropic Claude API
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API (fallback/alternative)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# ElevenLabs Voice AI (Legacy)
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# Cartesia AI - Real-time TTS/STT (Recommended)
# Get from: https://play.cartesia.ai/console
# Cost: ~98% cheaper than ElevenLabs (~$0.00154/min vs $0.10/min)
# Features: 40-90ms latency, voice cloning (3s), emotional TTS with laughter
CARTESIA_API_KEY=your-cartesia-api-key-here

# Feature Flag: Enable Cartesia instead of ElevenLabs
# Set to 'true' to use Cartesia, 'false' to use ElevenLabs
# Default: false (ElevenLabs)
USE_CARTESIA=false

# ========================================
# Stripe Payment Integration (Optional)
# ========================================
# Get from: https://dashboard.stripe.com/apikeys

STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_BASIC_PRICE_ID=price_basic_monthly
STRIPE_PROFESSIONAL_PRICE_ID=price_professional_monthly
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_monthly

# Stripe Metered Billing (Usage-Based Pricing)
# Create metered prices in Stripe Dashboard > Products > Add price > Metered billing
STRIPE_METERED_PRICE_RESERVATION=price_metered_reservation
STRIPE_METERED_PRICE_AI_CALL=price_metered_ai_call
STRIPE_METERED_PRICE_SMS=price_metered_sms
STRIPE_METERED_PRICE_WHATSAPP=price_metered_whatsapp

# Stripe Webhook Secret (for signature verification)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Vercel Cron Secret (secures cron endpoints like /api/report-usage)
CRON_SECRET=your-cron-secret-here

# ========================================
# Email (Resend)
# ========================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-here

# ========================================
# Redis Rate Limiting (Upstash)
# ========================================
# Get from: https://console.upstash.com (create a Redis database)
# Without these, rate limiting falls back to in-memory (not persistent across Vercel instances)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token-here

# ========================================
# Frontend Supabase (Vite injects these at build time)
# ========================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ========================================
# Twilio (Voice/SMS Integration)
# ========================================
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# ========================================
# WhatsApp (Meta Cloud API)
# ========================================
# Get from: https://developers.facebook.com/apps
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# ========================================
# Google Cloud / Vertex AI (Optional)
# ========================================
# Used for advanced ML predictions
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_ENDPOINT=your-vertex-ai-endpoint
GEMINI_MODEL=gemini-2.0-flash

# ========================================
# Square POS Integration (Optional)
# ========================================
# Get from: https://developer.squareup.com/apps
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_APPLICATION_ID=your-square-application-id
SQUARE_APPLICATION_SECRET=your-square-application-secret
SQUARE_WEBHOOK_SIGNATURE_KEY=your-square-webhook-signature-key
SQUARE_ENVIRONMENT=sandbox

# ========================================
# Sentry Error Tracking (Optional)
# ========================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ========================================
# Legacy - Airtable (DEPRECATED Nov 1, 2025)
# ========================================
# These are no longer used but kept for reference
# The system has been migrated to Supabase PostgreSQL

# AIRTABLE_API_KEY=your-airtable-api-key-here
# AIRTABLE_BASE_ID=your-base-id
# RESERVATIONS_TABLE_ID=your-reservations-table-id
# RESTAURANT_INFO_TABLE_ID=your-restaurant-info-table-id
# TABLES_TABLE_ID=your-tables-table-id
# MENU_ITEMS_TABLE_ID=your-menu-items-table-id
# SERVICE_RECORDS_TABLE_ID=your-service-records-table-id

# ========================================
# Multi-Tenant WhatsApp Configuration
# ========================================
# Enable multi-tenant mode for WhatsApp reservations across multiple restaurants
# When enabled, a single WhatsApp number can serve all subscribed restaurants

# Enable multi-tenant mode (true/false)
# Default: false (single-tenant mode)
MULTI_TENANT_MODE=false

# Central Registry Database (Optional - uses main Supabase if not set)
# If you want to use a separate Supabase project for the central registry:
# CENTRAL_SUPABASE_URL=https://your-central-project.supabase.co
# CENTRAL_SUPABASE_SERVICE_ROLE_KEY=your-central-service-role-key

# When MULTI_TENANT_MODE=true:
# 1. Customers can text/call the WhatsApp number and mention any restaurant
# 2. The AI identifies the restaurant using fuzzy matching
# 3. Reservations are routed to the correct restaurant's database
# 4. Each restaurant sees only their own reservations in the dashboard

# ========================================
# Quick Setup Guide
# ========================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Set up Supabase:
#    - Create a Supabase project at https://app.supabase.com
#    - Get your project URL and anon key from Settings > API
#    - Update SUPABASE_URL and SUPABASE_ANON_KEY above
#
# 3. Set up AI services:
#    - Get Anthropic API key from https://console.anthropic.com
#    - Get OpenAI API key from https://platform.openai.com
#    - Get ElevenLabs key from https://elevenlabs.io
#
# 4. Run the application:
#    npm install --legacy-peer-deps
#    npm run dev:full
#
# For production deployment on Vercel:
# - Add all environment variables in Vercel dashboard
# - See README.md for detailed setup instructions
