# API Base URL - Leave empty to use same domain (Vercel)
VITE_API_BASE_URL=

# ElevenLabs Conversational AI
# Get your agent ID from: https://elevenlabs.io/app/conversational-ai
# Make sure the agent is set to "Public" and authentication is disabled
VITE_ELEVENLABS_AGENT_ID=your_agent_id_here

# Supabase Auth (Google OAuth)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
VITE_STRIPE_STARTER_PRICE_ID=price_starter_monthly
VITE_STRIPE_GROWTH_PRICE_ID=price_growth_monthly
VITE_STRIPE_SCALE_PRICE_ID=price_scale_monthly
VITE_STRIPE_STARTER_ANNUAL_PRICE_ID=price_starter_annual
VITE_STRIPE_GROWTH_ANNUAL_PRICE_ID=price_growth_annual
VITE_STRIPE_SCALE_ANNUAL_PRICE_ID=price_scale_annual
