{
  "installCommand": "npm install",
  "buildCommand": "cd client && rm -rf dist node_modules/.vite && npm install && npm run build",
  "outputDirectory": "client/dist",
  "build": {
    "env": {
      "PYTHON_VERSION": "3.9"
    }
  },
  "functions": {
    "api/**/*.js": {
      "excludeFiles": "lambda/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/revenue-stats",
      "destination": "/api/revenue-stats"
    },
    {
      "source": "/api/voice-persona",
      "destination": "/api/voice-persona"
    },
    {
      "source": "/api/table-suggestion",
      "destination": "/api/table-suggestion"
    },
    {
      "source": "/api/push-subscribe",
      "destination": "/api/push-subscribe"
    },
    {
      "source": "/api/push-send",
      "destination": "/api/push-send"
    },
    {
      "source": "/api/deposit-config",
      "destination": "/api/deposit-config"
    },
    {
      "source": "/api/create-deposit-intent",
      "destination": "/api/create-deposit-intent"
    },
    {
      "source": "/api/capture-deposit",
      "destination": "/api/capture-deposit"
    },
    {
      "source": "/api/release-deposit",
      "destination": "/api/release-deposit"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/restaurants/:city/:cuisine",
      "destination": "/api/seo/city-cuisine?city=:city&cuisine=:cuisine"
    },
    {
      "source": "/vs/:competitor",
      "destination": "/api/seo/vs?competitor=:competitor"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/seo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-late-reservations",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/update-churn-scores",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/report-usage",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/generate-reflections",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/proactive-comms",
      "schedule": "0 10 * * 0"
    },
    {
      "path": "/api/cron/refresh-restaurant-profiles",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/demo-nurture",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/cleanup-expired-demos",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/warm-seo-cache",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/manager-briefings?type=end_of_day",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/manager-briefings?type=morning",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/manager-alerts?type=low_covers",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/manager-alerts?type=high_noshows",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/manager-alerts?type=late_cancellations",
      "schedule": "0 12,14,16,18,20 * * *"
    }
  ]
}
