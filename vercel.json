      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/cleanup-whatsapp-dedup",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/compress-memories",
      "schedule": "30 4 * * 6"
    },
    {
      "path": "/api/cron/automated-campaigns",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/health-alert",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/monitor-meta-token-expiry",
      "schedule": "5 10 * * *"
