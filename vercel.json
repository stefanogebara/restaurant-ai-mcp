      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/manager-briefings?type=morning",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/manager-alerts?type=low_covers",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/manager-alerts?type=high_noshows",
