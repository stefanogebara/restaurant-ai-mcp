{
  "installCommand": "npm ci --prefer-offline --no-audit && cd client && npm ci --legacy-peer-deps --prefer-offline --no-audit",
  "buildCommand": "cd client && npx vite build && node prepare-landing-output.cjs && node cache-bust-sw.cjs",
  "ignoreCommand": "bash vercel-ignore-build.sh",
  "outputDirectory": "client/dist",
  "regions": ["fra1"],
  "functions": {
    "api/index.js": {
      "excludeFiles": "{lambda/**,api/_app/__tests__/**,**/*.test.js,**/*.spec.js,ml-training-data/**,e2e/**,.claude/**,seatable-ads/**,reels-toolkit/**,remotion/**}",
      "memory": 512,
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/proposta",
      "destination": "/api/index.js"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.js"
    },
    {
      "source": "/restaurants/:city/:cuisine",
      "destination": "/api/index.js"
    },
    {
      "source": "/sistema-de-reservas/:city/:cuisine",
      "destination": "/api/index.js"
    },
    {
      "source": "/blog",
      "destination": "/api/index.js"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/index.js"
    },
    {
      "source": "/vs/:competitor",
      "destination": "/api/index.js"
    },
    {
      "source": "/v3/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/book/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob: https://js.stripe.com https://*.posthog.com https://elevenlabs.io https://unpkg.com https://cdn.elevenlabs.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdn.elevenlabs.io; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.stripe.com https://*.posthog.com https://api.anthropic.com https://api.elevenlabs.io https://*.elevenlabs.io wss://*.elevenlabs.io https://*.vercel.app https://*.ingest.de.sentry.io https://*.ingest.us.sentry.io https://*.sentry.io https://unpkg.com; frame-src 'self' https://js.stripe.com https://elevenlabs.io; frame-ancestors 'self' https://*.seatable.one; media-src 'self' data: blob: https://*.supabase.co https://*.elevenlabs.io https://storage.googleapis.com/eleven-public-prod/; worker-src 'self' blob: https://*.elevenlabs.io https://cdn.elevenlabs.io;"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob: https://js.stripe.com https://*.posthog.com https://elevenlabs.io https://unpkg.com https://cdn.elevenlabs.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdn.elevenlabs.io; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.stripe.com https://*.posthog.com https://api.anthropic.com https://api.elevenlabs.io https://*.elevenlabs.io wss://*.elevenlabs.io https://*.vercel.app https://*.ingest.de.sentry.io https://*.ingest.us.sentry.io https://*.sentry.io https://unpkg.com; frame-src 'self' https://js.stripe.com https://elevenlabs.io; frame-ancestors 'self'; media-src 'self' data: blob: https://*.supabase.co https://*.elevenlabs.io https://storage.googleapis.com/eleven-public-prod/; worker-src 'self' blob: https://*.elevenlabs.io https://cdn.elevenlabs.io;"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/seo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/demo",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob: https://js.stripe.com https://*.posthog.com https://elevenlabs.io https://unpkg.com https://cdn.elevenlabs.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdn.elevenlabs.io; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.stripe.com https://*.posthog.com https://api.anthropic.com https://api.elevenlabs.io https://*.elevenlabs.io wss://*.elevenlabs.io https://*.vercel.app https://*.ingest.de.sentry.io https://*.ingest.us.sentry.io https://*.sentry.io https://unpkg.com; frame-src 'self' https://js.stripe.com https://elevenlabs.io; frame-ancestors 'self' https://*.seatable.one; media-src 'self' data: blob: https://*.supabase.co https://*.elevenlabs.io https://storage.googleapis.com/eleven-public-prod/; worker-src 'self' blob: https://*.elevenlabs.io https://cdn.elevenlabs.io;"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/run?job=check-late-reservations",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/run-2min?job=prospect-flush",
      "schedule": "*/15 12-22 * * *"
    },
    {
      "path": "/api/cron/run-2min?job=prospect-nudge",
      "schedule": "40 13-21 * * 1-5"
    },
    {
      "path": "/api/cron/run-2min?job=prospect-dispatch",
      "schedule": "10 13-19 * * 1-5"
    },
    {
      "path": "/api/cron/run-5min?job=prospect-score-outcomes",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/run?job=prospect-handoff-digest",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/cron/run?job=prospect-founder-email",
      "schedule": "0 13,16,19 * * *"
    },
    {
      "path": "/api/cron/run?job=process-scheduled-ig-posts",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/run?job=send-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/run?job=update-churn-scores",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/report-usage",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/run?job=generate-reflections",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/run?job=proactive-comms",
      "schedule": "0 10 * * 0"
    },
    {
      "path": "/api/cron/run?job=refresh-restaurant-profiles",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/run?job=demo-nurture",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/run?job=cleanup-expired-demos",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/run?job=cleanup-booking-deposits",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/cron/run?job=warm-seo-cache",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/run?job=manager-briefings&type=end_of_day",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/run?job=manager-briefings&type=morning",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/run?job=manager-alerts&type=low_covers",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/run?job=manager-alerts&type=high_noshows",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/run?job=manager-alerts&type=late_cancellations",
      "schedule": "0 12,14,16,18,20 * * *"
    },
    {
      "path": "/api/cron/run?job=send-feedback",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/run?job=send-surveys",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/run?job=send-campaigns",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/run?job=pre-reservation-upsell",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/run?job=analytics-briefing",
      "schedule": "5 9 * * *"
    },
    {
      "path": "/api/cron/run?job=cleanup-waitlist",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/run?job=cleanup-whatsapp-dedup",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/run?job=compress-memories",
      "schedule": "30 4 * * 6"
    },
    {
      "path": "/api/cron/run?job=automated-campaigns",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/run?job=health-alert",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/run?job=monitor-meta-token-expiry",
      "schedule": "5 10 * * *"
    },
    {
      "path": "/api/cron/run?job=sync-stripe-connect-accounts",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/run?job=sync-conversation-data",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/run?job=validate-conversations",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/run-5min?job=compile-wiki",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/run?job=weekly-report",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/run?job=prospect-enrich",
      "schedule": "20 * * * *"
    }
  ]
}
