{
  "installCommand": "npm install",
  "buildCommand": "cd client && npm install && npx vite build && node cache-bust-sw.cjs",
  "outputDirectory": "client/dist",
  "functions": {
    "api/manager-chat.js": {
      "maxDuration": 120
    },
    "api/twilio-voice-connect.js": {
      "maxDuration": 120
    },
    "api/**/*.js": {
      "excludeFiles": "{lambda/**,api/__tests__/**,**/*.test.js,**/*.spec.js,ml-training-data/**,e2e/**,.claude/**,seatable-ads/**,reels-toolkit/**,remotion/**}",
      "memory": 512,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/restaurants/:city/:cuisine",
      "destination": "/api/seo/city-cuisine?city=:city&cuisine=:cuisine"
    },
    {
      "source": "/vs/:competitor",
      "destination": "/api/seo/vs?competitor=:competitor"
    },
    {
      "source": "/api/voice-experiments",
      "destination": "/api/voice-experiments.js"
    },
    {
      "source": "/api/event-checkout",
      "destination": "/api/event-checkout.js"
    },
    {
      "source": "/api/event-booking-confirm",
      "destination": "/api/event-booking-confirm.js"
    },
    {
      "source": "/api/event-refund",
      "destination": "/api/event-refund.js"
    },
    {
      "source": "/api/event-public",
      "destination": "/api/event-public.js"
    },
    {
      "source": "/api/booking-qr",
      "destination": "/api/booking-qr.js"
    },
    {
      "source": "/api/widget-config",
      "destination": "/api/widget-config.js"
    },
    {
      "source": "/api/campaign-automations",
      "destination": "/api/campaign-automations.js"
    },
    {
      "source": "/api/campaign-unsubscribe",
      "destination": "/api/campaign-unsubscribe.js"
    },
    {
      "source": "/api/api-keys",
      "destination": "/api/api-keys.js"
    },
    {
      "source": "/api/webhooks-config",
      "destination": "/api/webhooks-config.js"
    },
    {
      "source": "/api/pos/service-completion",
      "destination": "/api/pos/service-completion.js"
    },
    {
      "source": "/api/pos/reservations",
      "destination": "/api/pos/reservations.js"
    },
    {
      "source": "/api/pos/table-status",
      "destination": "/api/pos/table-status.js"
    },
    {
      "source": "/api/square/auth",
      "destination": "/api/square/auth.js"
    },
    {
      "source": "/api/square/sync",
      "destination": "/api/square/sync.js"
    },
    {
      "source": "/api/ical-feed",
      "destination": "/api/ical-feed.js"
    },
    {
      "source": "/api/external-booking-webhook",
      "destination": "/api/external-booking-webhook.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/book/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob: https://js.stripe.com https://*.posthog.com https://elevenlabs.io https://unpkg.com https://cdn.elevenlabs.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdn.elevenlabs.io; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.stripe.com https://*.posthog.com https://api.anthropic.com https://api.elevenlabs.io https://*.elevenlabs.io wss://*.elevenlabs.io https://*.vercel.app https://*.ingest.de.sentry.io https://*.ingest.us.sentry.io https://*.sentry.io https://unpkg.com; frame-src https://js.stripe.com https://elevenlabs.io; frame-ancestors 'self' https://*.seatable.one; media-src 'self' data: blob: https://*.supabase.co https://*.elevenlabs.io; worker-src 'self' blob: https://*.elevenlabs.io https://cdn.elevenlabs.io;"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob: https://js.stripe.com https://*.posthog.com https://elevenlabs.io https://unpkg.com https://cdn.elevenlabs.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdn.elevenlabs.io; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.stripe.com https://*.posthog.com https://api.anthropic.com https://api.elevenlabs.io https://*.elevenlabs.io wss://*.elevenlabs.io https://*.vercel.app https://*.ingest.de.sentry.io https://*.ingest.us.sentry.io https://*.sentry.io https://unpkg.com; frame-src https://js.stripe.com https://elevenlabs.io; frame-ancestors 'self'; media-src 'self' data: blob: https://*.supabase.co https://*.elevenlabs.io; worker-src 'self' blob: https://*.elevenlabs.io https://cdn.elevenlabs.io;"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/seo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-late-reservations",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/update-churn-scores",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/report-usage",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/generate-reflections",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/proactive-comms",
      "schedule": "0 10 * * 0"
    },
    {
      "path": "/api/cron/refresh-restaurant-profiles",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/demo-nurture",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/cleanup-expired-demos",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/warm-seo-cache",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/manager-briefings?type=end_of_day",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/manager-briefings?type=morning",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/manager-alerts?type=low_covers",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/manager-alerts?type=high_noshows",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/manager-alerts?type=late_cancellations",
      "schedule": "0 12,14,16,18,20 * * *"
    },
    {
      "path": "/api/cron/send-feedback",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/send-surveys",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/send-campaigns",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/pre-reservation-upsell",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/analytics-briefing",
      "schedule": "5 9 * * *"
    },
    {
      "path": "/api/cron/cleanup-waitlist",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/automated-campaigns",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/health-alert",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/sync-conversation-data",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/validate-conversations",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/square/sync?action=cron_catalog",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/square/sync?action=cron_refresh",
      "schedule": "0 2 * * *"
    }
  ]
}
