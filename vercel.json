{
  "installCommand": "npm install",
  "buildCommand": "ls client/dist || (cd client && npm install --legacy-peer-deps 2>&1 | tail -20 && npm run build 2>&1 | tail -20 && node cache-bust-sw.js)",
  "outputDirectory": "client/dist",
  "functions": {
    "api/**/*.js": {
      "excludeFiles": "lambda/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/restaurants/:city/:cuisine",
      "destination": "/api/seo/city-cuisine?city=:city&cuisine=:cuisine"
    },
    {
      "source": "/vs/:competitor",
      "destination": "/api/seo/vs?competitor=:competitor"
    },
    {
      "source": "/api/voice-experiments",
      "destination": "/api/voice-experiments.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/book/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob: https://js.stripe.com https://*.posthog.com https://elevenlabs.io https://unpkg.com https://cdn.elevenlabs.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdn.elevenlabs.io; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.stripe.com https://*.posthog.com https://api.anthropic.com https://api.elevenlabs.io https://*.elevenlabs.io wss://*.elevenlabs.io https://*.vercel.app https://*.ingest.de.sentry.io https://*.ingest.us.sentry.io https://*.sentry.io https://unpkg.com; frame-src https://js.stripe.com https://elevenlabs.io; frame-ancestors *; media-src 'self' data: blob: https://*.supabase.co https://*.elevenlabs.io; worker-src 'self' blob: https://*.elevenlabs.io https://cdn.elevenlabs.io;"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob: https://js.stripe.com https://*.posthog.com https://elevenlabs.io https://unpkg.com https://cdn.elevenlabs.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdn.elevenlabs.io; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.stripe.com https://*.posthog.com https://api.anthropic.com https://api.elevenlabs.io https://*.elevenlabs.io wss://*.elevenlabs.io https://*.vercel.app https://*.ingest.de.sentry.io https://*.ingest.us.sentry.io https://*.sentry.io https://unpkg.com; frame-src https://js.stripe.com https://elevenlabs.io; frame-ancestors 'self'; media-src 'self' data: blob: https://*.supabase.co https://*.elevenlabs.io; worker-src 'self' blob: https://*.elevenlabs.io https://cdn.elevenlabs.io;"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/seo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-late-reservations",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/update-churn-scores",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/report-usage",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/generate-reflections",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/proactive-comms",
      "schedule": "0 10 * * 0"
    },
    {
      "path": "/api/cron/refresh-restaurant-profiles",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/demo-nurture",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/cleanup-expired-demos",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/warm-seo-cache",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/manager-briefings?type=end_of_day",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/manager-briefings?type=morning",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/manager-alerts?type=low_covers",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/manager-alerts?type=high_noshows",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/manager-alerts?type=late_cancellations",
      "schedule": "0 12,14,16,18,20 * * *"
    },
    {
      "path": "/api/cron/send-feedback",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/send-campaigns",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/pre-reservation-upsell",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/analytics-briefing",
      "schedule": "5 9 * * *"
    }
  ]
}
