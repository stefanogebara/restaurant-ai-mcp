{
  "installCommand": "npm ci --prefer-offline --no-audit && cd client && npm ci --legacy-peer-deps --prefer-offline --no-audit",
  "buildCommand": "cd client && npx vite build && node cache-bust-sw.cjs",
  "outputDirectory": "client/dist",
  "functions": {
    "api/manager-chat.js": {
      "maxDuration": 120
    },
    "api/twilio-voice-connect.js": {
      "maxDuration": 120
    },
    "api/waha-webhook.js": {
      "maxDuration": 120
    },
    "api/whatsapp-webhook.js": {
      "maxDuration": 120
    },
    "api/cron/compile-wiki.js": {
      "maxDuration": 300
    },
    "api/cron/prospect-flush.js": {
      "maxDuration": 120
    },
    "api/cron/prospect-nudge.js": {
      "maxDuration": 120
    },
    "api/prospect-enrich.js": {
      "maxDuration": 120
    },
    "api/prospect-discovery-worker.js": {
      "maxDuration": 60
    },
    "api/cron/prospect-score-outcomes.js": {
      "maxDuration": 120
    },
    "api/**/*.js": {
      "excludeFiles": "{lambda/**,api/__tests__/**,**/*.test.js,**/*.spec.js,ml-training-data/**,e2e/**,.claude/**,seatable-ads/**,reels-toolkit/**,remotion/**}",
      "memory": 512,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/prospect-discover",
      "destination": "/api/prospect-discover.js"
    },
    {
      "source": "/api/prospect-dispatch",
      "destination": "/api/prospect-dispatch.js"
    },
    {
      "source": "/api/prospect-enrich",
      "destination": "/api/prospect-enrich.js"
    },
    {
      "source": "/api/prospect-admin",
      "destination": "/api/prospect-admin.js"
    },
    {
      "source": "/api/prospect-discovery-worker",
      "destination": "/api/prospect-discovery-worker.js"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/demo/create",
      "destination": "/api/demo?action=create"
    },
    {
      "source": "/api/demo/session",
      "destination": "/api/demo?action=session"
    },
    {
      "source": "/api/demo/convert",
      "destination": "/api/demo?action=convert"
    },
    {
      "source": "/restaurants/:city/:cuisine",
      "destination": "/api/seo/city-cuisine?city=:city&cuisine=:cuisine"
    },
    {
      "source": "/vs/:competitor",
      "destination": "/api/seo/vs?competitor=:competitor"
    },
    {
      "source": "/api/voice-experiments",
      "destination": "/api/voice-experiments.js"
    },
    {
      "source": "/api/event-checkout",
      "destination": "/api/event-checkout.js"
    },
    {
      "source": "/api/event-booking-confirm",
      "destination": "/api/event-booking-confirm.js"
    },
    {
      "source": "/api/event-refund",
      "destination": "/api/event-refund.js"
    },
    {
      "source": "/api/event-public",
      "destination": "/api/event-public.js"
    },
    {
      "source": "/api/voice-forward",
      "destination": "/api/voice-forward.js"
    },
    {
      "source": "/api/booking-qr",
      "destination": "/api/booking-qr.js"
    },
    {
      "source": "/api/booking-token",
      "destination": "/api/booking-token.js"
    },
    {
      "source": "/api/widget-config",
      "destination": "/api/widget-config.js"
    },
    {
      "source": "/api/campaign-automations",
      "destination": "/api/campaign-automations.js"
    },
    {
      "source": "/api/campaign-unsubscribe",
      "destination": "/api/campaign-unsubscribe.js"
    },
    {
      "source": "/api/api-keys",
      "destination": "/api/api-keys.js"
    },
    {
      "source": "/api/webhooks-config",
      "destination": "/api/webhooks-config.js"
    },
    {
      "source": "/api/pos/service-completion",
      "destination": "/api/pos/service-completion.js"
    },
    {
      "source": "/api/pos/reservations",
      "destination": "/api/pos/reservations.js"
    },
    {
      "source": "/api/pos/table-status",
      "destination": "/api/pos/table-status.js"
    },
    {
      "source": "/api/square/auth",
      "destination": "/api/square?route=auth"
    },
    {
      "source": "/api/square/callback",
      "destination": "/api/square?route=callback"
    },
    {
      "source": "/api/square/sync",
      "destination": "/api/square?route=sync"
    },
    {
      "source": "/api/square/webhook",
      "destination": "/api/square-webhook.js"
    },
    {
      "source": "/api/request-deposit-link",
      "destination": "/api/request-deposit-link.js"
    },
    {
      "source": "/api/admin-health",
      "destination": "/api/admin-health.js"
    },
    {
      "source": "/api/ical-feed",
      "destination": "/api/ical-feed.js"
    },
    {
      "source": "/api/external-booking-webhook",
      "destination": "/api/external-booking-webhook.js"
    },
    {
      "source": "/api/google-booking/server",
      "destination": "/api/google-booking/server.js"
    },
    {
      "source": "/v3/HealthCheck",
      "destination": "/api/google-booking/server.js?action=HealthCheck"
    },
    {
      "source": "/v3/HealthCheck/",
      "destination": "/api/google-booking/server.js?action=HealthCheck"
    },
    {
      "source": "/v3/BatchAvailabilityLookup",
      "destination": "/api/google-booking/server.js?action=BatchAvailabilityLookup"
    },
    {
      "source": "/v3/CreateBooking",
      "destination": "/api/google-booking/server.js?action=CreateBooking"
    },
    {
      "source": "/v3/UpdateBooking",
      "destination": "/api/google-booking/server.js?action=UpdateBooking"
    },
    {
      "source": "/api/customer-reservation",
      "destination": "/api/customer-reservation.js"
    },
    {
      "source": "/api/report-pdf",
      "destination": "/api/report-pdf.js"
    },
    {
      "source": "/api/subscription/status",
      "destination": "/api/subscription-status.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/api-not-found"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/book/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob: https://js.stripe.com https://*.posthog.com https://elevenlabs.io https://unpkg.com https://cdn.elevenlabs.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdn.elevenlabs.io; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.stripe.com https://*.posthog.com https://api.anthropic.com https://api.elevenlabs.io https://*.elevenlabs.io wss://*.elevenlabs.io https://*.vercel.app https://*.ingest.de.sentry.io https://*.ingest.us.sentry.io https://*.sentry.io https://unpkg.com; frame-src 'self' https://js.stripe.com https://elevenlabs.io; frame-ancestors 'self' https://*.seatable.one; media-src 'self' data: blob: https://*.supabase.co https://*.elevenlabs.io; worker-src 'self' blob: https://*.elevenlabs.io https://cdn.elevenlabs.io;"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob: https://js.stripe.com https://*.posthog.com https://elevenlabs.io https://unpkg.com https://cdn.elevenlabs.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdn.elevenlabs.io; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.stripe.com https://*.posthog.com https://api.anthropic.com https://api.elevenlabs.io https://*.elevenlabs.io wss://*.elevenlabs.io https://*.vercel.app https://*.ingest.de.sentry.io https://*.ingest.us.sentry.io https://*.sentry.io https://unpkg.com; frame-src 'self' https://js.stripe.com https://elevenlabs.io; frame-ancestors 'self'; media-src 'self' data: blob: https://*.supabase.co https://*.elevenlabs.io; worker-src 'self' blob: https://*.elevenlabs.io https://cdn.elevenlabs.io;"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/seo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/demo",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob: https://js.stripe.com https://*.posthog.com https://elevenlabs.io https://unpkg.com https://cdn.elevenlabs.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdn.elevenlabs.io; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.stripe.com https://*.posthog.com https://api.anthropic.com https://api.elevenlabs.io https://*.elevenlabs.io wss://*.elevenlabs.io https://*.vercel.app https://*.ingest.de.sentry.io https://*.ingest.us.sentry.io https://*.sentry.io https://unpkg.com; frame-src 'self' https://js.stripe.com https://elevenlabs.io; frame-ancestors 'self' https://*.seatable.one; media-src 'self' data: blob: https://*.supabase.co https://*.elevenlabs.io; worker-src 'self' blob: https://*.elevenlabs.io https://cdn.elevenlabs.io;"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-late-reservations",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/prospect-flush",
      "schedule": "*/15 12-22 * * *"
    },
    {
      "path": "/api/cron/prospect-nudge",
      "schedule": "40 13-21 * * 1-5"
    },
    {
      "path": "/api/cron/prospect-score-outcomes",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/process-scheduled-ig-posts",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/update-churn-scores",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/report-usage",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/generate-reflections",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/proactive-comms",
      "schedule": "0 10 * * 0"
    },
    {
      "path": "/api/cron/refresh-restaurant-profiles",
      "schedule": "0 3 * * 1"
    },
    {
      "path": "/api/cron/demo-nurture",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/cleanup-expired-demos",
      "schedule": "0 3 * * *"
    },
    {
