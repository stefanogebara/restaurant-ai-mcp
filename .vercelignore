# Exclude training data and large files from Vercel deployments
ml-training-data/
ml-training/
hotel_bookings.csv
scripts/train-ml-model.py

# Exclude ENTIRE Lambda directory (deployed separately to AWS Lambda)
# This directory contains 400+ MB of Python dependencies not needed for Vercel
lambda/

# Exclude Python dependencies (only needed for Lambda, not Vercel)
requirements.txt

# Exclude development files
*.log
.env.local
.claude/
parallel-agents/
.git/

# Keep ml_models/ - we need the trained model for production

# Exclude test files (they get bundled as serverless functions, adding ~10min to build)
api/__tests__/
client/src/**/__tests__/
**/*.test.js
**/*.test.ts
**/*.spec.js
**/*.spec.ts
e2e/
test-screenshots/
test-results/
